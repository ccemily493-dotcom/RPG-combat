{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rpg/v0.3/character-state.schema.json",
  "title": "Universal RPG Character State v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "resolved_stats", "resources", "transform", "body_zones", "statuses", "modifiers", "action_economy"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "category_profile": {
      "description": "Optional provenance for how stats were resolved; never replaces resolved_stats at runtime.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "default_category": { "type": "string" },
        "per_stat": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "resolved_stats": { "$ref": "#/$defs/stats" },
    "resources": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/resource" },
      "required": ["health", "stability", "energy"],
      "properties": {
        "health": { "$ref": "#/$defs/resource" },
        "stability": { "$ref": "#/$defs/resource" },
        "energy": { "$ref": "#/$defs/resource" }
      }
    },
    "harm_capacity": { "type": "number", "minimum": 0, "default": 100, "x-tunable": true },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "velocity", "facing", "posture"],
      "properties": {
        "position": { "$ref": "#/$defs/vector3" },
        "velocity": { "$ref": "#/$defs/vector3" },
        "facing": { "$ref": "#/$defs/vector3" },
        "posture": { "enum": ["standing", "crouched", "prone", "airborne", "restrained", "incapacitated", "extension"] }
      }
    },
    "body_zones": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/bodyZone" }
    },
    "statuses": { "type": "array", "items": { "$ref": "#/$defs/status" } },
    "modifiers": { "type": "array", "items": { "$ref": "#/$defs/modifier" } },
    "action_economy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "reaction_available", "committed_until_turn"],
      "properties": {
        "available": { "type": "boolean", "default": true },
        "reaction_available": { "type": "boolean", "default": true },
        "committed_until_turn": { "type": "integer", "minimum": 0, "default": 0, "x-tunable": true },
        "action_capacity": { "type": "integer", "minimum": 0, "default": 1, "x-tunable": true },
        "actions_remaining": { "type": "integer", "minimum": 0, "default": 1, "x-tunable": true },
        "actions_reserved": { "type": "integer", "minimum": 0, "default": 0, "x-tunable": true },
        "reaction_capacity": { "type": "integer", "minimum": 0, "default": 1, "x-tunable": true },
        "reactions_remaining": { "type": "integer", "minimum": 0, "default": 1, "x-tunable": true },
        "reactions_reserved": { "type": "integer", "minimum": 0, "default": 0, "x-tunable": true }
      }
    },
    "cooldowns": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "integer", "minimum": 0 },
          {
            "type": "object", "additionalProperties": false, "required": ["remaining", "duration", "unit", "starts", "started_turn", "source_ref"],
            "properties": {
              "remaining": { "type": "integer", "minimum": 0 }, "duration": { "type": "integer", "minimum": 1 },
              "unit": { "const": "TURN" }, "starts": { "const": "ON_USE" }, "started_turn": { "type": "integer", "minimum": 0 }, "source_ref": { "type": "string" }
            }
          }
        ]
      },
      "default": {}
    },
    "inventory_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] },
    "extension_state": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*:" },
      "additionalProperties": true,
      "default": {}
    }
  },
  "$defs": {
    "statValue": { "type": "number", "minimum": 0, "maximum": 100 },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_capability", "movement", "reaction", "coordination", "resistance", "perception", "strategy", "energy_capacity", "energy_output", "energy_control", "energy_efficiency"],
      "properties": {
        "physical_capability": { "$ref": "#/$defs/statValue" },
        "movement": { "$ref": "#/$defs/statValue" },
        "reaction": { "$ref": "#/$defs/statValue" },
        "coordination": { "$ref": "#/$defs/statValue" },
        "resistance": { "$ref": "#/$defs/statValue" },
        "perception": { "$ref": "#/$defs/statValue" },
        "strategy": { "$ref": "#/$defs/statValue" },
        "energy_capacity": { "$ref": "#/$defs/statValue" },
        "energy_output": { "$ref": "#/$defs/statValue" },
        "energy_control": { "$ref": "#/$defs/statValue" },
        "energy_efficiency": { "$ref": "#/$defs/statValue" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "maximum"],
      "properties": {
        "current": { "type": "number", "minimum": 0 },
        "maximum": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "bodyZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "allocation_weight", "resistance", "vulnerability", "disabled"],
      "properties": {
        "id": { "type": "string" },
        "allocation_weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "resistance": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 } },
        "vulnerability": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 3 } },
        "disabled": { "type": "boolean", "default": false },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_ref", "intensity", "remaining_turns", "stacking_rule"],
      "properties": {
        "id": { "type": "string" },
        "source_ref": { "type": "string" },
        "intensity": { "type": "number", "minimum": 0 },
        "remaining_turns": { "type": ["integer", "null"], "minimum": 0 },
        "stacking_rule": { "enum": ["refresh", "stack", "replace", "ignore", "strongest_wins", "intensify", "independent", "reject"] },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] },
        "duration": { "$ref": "https://example.invalid/rpg/v0.3/temporal-state.schema.json#/$defs/duration" },
        "created_turn": { "type": "integer", "minimum": 0 }
      }
    },
    "modifier": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "layer", "target", "operation"],
      "properties": {
        "id": { "type": "string" },
        "layer": { "const": "CHARACTER" },
        "target": { "type": "string" },
        "operation": { "enum": ["additive", "percentage", "multiplicative", "bounded"] },
        "value": { "type": "number" },
        "lower": { "type": "number" },
        "upper": { "type": "number" },
        "priority": { "type": "integer", "default": 0, "x-tunable": true },
        "when": { "type": "object" },
        "source_ref": { "type": "string" }
        ,"duration": { "$ref": "https://example.invalid/rpg/v0.3/temporal-state.schema.json#/$defs/duration" }
        ,"created_turn": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
