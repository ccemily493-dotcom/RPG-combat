{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rpg/v0.5/semantic-dictionary-entry.schema.json",
  "title": "Universal RPG Semantic Dictionary Entry v0.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["entry_id", "locale", "namespace", "version", "surface_forms", "canonical_type", "tags", "priority", "constraints", "examples", "source"],
  "properties": {
    "entry_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]*$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$" },
    "namespace": { "enum": ["SESSION", "EXTENSION", "CHARACTER", "ABILITY", "LOCALE", "UNIVERSAL"] },
    "version": { "type": "string", "minLength": 1 },
    "surface_forms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "canonical_type": {
      "enum": ["ATTACK", "DEFEND", "MOVE", "DODGE", "BLOCK", "PARRY", "GRAB", "RELEASE", "THROW", "JUMP", "CROUCH", "RUN", "WALK", "TURN", "APPROACH", "RETREAT", "INTERACT", "USE_OBJECT", "USE_ABILITY", "WAIT", "OBSERVE", "TARGET", "AIM", "REPOSITION", "INTERRUPT", "COUNTER", "FEINT", "DISTRACTION", "AMBUSH", "FLANK", "BLIND_SPOT", "BAIT", "TRAP", "COVER", "INTERRUPT_SETUP", "COUNTER_SETUP", "ISOLATE", "RESOURCE_DENIAL", "AREA_DENIAL", "ESCAPE_SETUP"]
    },
    "canonical_subtype": { "type": ["string", "null"], "enum": [null, "PUNCH", "KICK", "HEADBUTT", "SHOVE", "SLASH", "THRUST", "PROJECTILE", "SHOT", "THROW_OBJECT"] },
    "ability_id": { "type": ["string", "null"] },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "priority": { "type": "integer" },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "requires_target": { "type": "boolean" },
        "requires_object": { "type": "boolean" },
        "requires_direction": { "type": "boolean" },
        "ability_context_only": { "type": "boolean" },
        "strategy_context_only": { "type": "boolean" }
      }
    },
    "examples": { "type": "array", "items": { "type": "string" } },
    "source": { "type": "string", "minLength": 1 }
  }
}
